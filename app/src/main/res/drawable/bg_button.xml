<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#1769FF"
                android:centerColor="#6A35FF"
                android:endColor="#B92CFF" />

            <corners
                android:radius="22dp" />

            <stroke
                android:width="2dp"
                android:color="#72D8FF" />

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00A8FF"
                android:centerColor="#4169FF"
                android:endColor="#A62BFF" />

            <corners
                android:radius="22dp" />

            <stroke
                android:width="1dp"
                android:color="#70D8FF" />

        </shape>

    </item>

</selector>
