<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#050B18"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <!-- TOP BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#AFC7FF"
                android:textSize="27sp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑  النسخة المميزة"
                android:textColor="#FFD54A"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- APP IMAGE -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/app_icon"
            android:scaleType="centerInside"
            android:contentDescription="مترجم الشاشة"/>


        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مترجم الشاشة"
            android:textColor="#FFFFFF"
            android:textSize="35sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ترجمة أي نص في شاشتك مباشرة"
            android:textColor="#9EB8E8"
            android:textSize="17sp"
            android:gravity="center"
            android:layout_marginTop="5dp"/>


        <!-- LANGUAGE BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:background="#0E1B34"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginTop="26dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#132443"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🇬🇧"
                    android:textSize="25sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  English"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <TextView
                android:layout_width="52dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="⇄"
                android:textColor="#69B7FF"
                android:textSize="29sp"
                android:textStyle="bold"/>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#132443"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="العربية"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  🇸🇦"
                    android:textSize="25sp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- START BUTTON -->

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="ابدأ الترجمة   ▶"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:backgroundTint="#287BFF"
            android:elevation="8dp"
            android:layout_marginTop="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="التقاط الشاشة وترجمة النص تلقائياً"
            android:textColor="#A8BCE2"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp"/>


        <!-- FEATURES ROW 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:layout_marginTop="24dp">

            <!-- REGION -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0C1930"
                android:padding="12dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="⌗"
                    android:textColor="#22D3EE"
                    android:textSize="36sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تحديد المنطقة"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="اختر الجزء المراد ترجمته"
                    android:textColor="#7185A8"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>


            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>


            <!-- CAMERA -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0C1930"
                android:padding="12dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="◎"
                    android:textColor="#FF4F91"
                    android:textSize="39sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ترجمة الكاميرا"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ترجمة مباشرة بالكاميرا"
                    android:textColor="#7185A8"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>


            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>


            <!-- IMAGES -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0C1930"
                android:padding="12dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="▧"
                    android:textColor="#21E6A1"
                    android:textSize="38sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ترجمة الصور"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="من المعرض أو الصور"
                    android:textColor="#7185A8"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- FEATURES ROW 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:layout_marginTop="10dp">

            <!-- GAMES -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0C1930"
                android:padding="12dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="♧"
                    android:textColor="#A855F7"
                    android:textSize="38sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="وضع الألعاب"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ترجمة سريعة للألعاب"
                    android:textColor="#7185A8"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>


            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>


            <!-- VIDEO -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0C1930"
                android:padding="12dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#FFB800"
                    android:textSize="34sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="وضع الفيديو"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ترجمة النص الظاهر"
                    android:textColor="#7185A8"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>


            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>


            <!-- HISTORY -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0C1930"
                android:padding="12dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="◷"
                    android:textColor="#9B6CFF"
                    android:textSize="38sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="سجل الترجمات"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="عرض الترجمات السابقة"
                    android:textColor="#7185A8"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- BOTTOM TOOLS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layoutDirection="ltr"
            android:background="#0B1830"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="❔&#10;كيفية الاستخدام"
                android:textColor="#B5C7E8"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▢&#10;القواميس"
                android:textColor="#B5C7E8"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="◉&#10;الإحصائيات"
                android:textColor="#B5C7E8"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/privacyButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="☰&#10;الإعدادات"
                android:textColor="#B5C7E8"
                android:textSize="11sp"/>

        </LinearLayout>


        <!-- STATUS -->

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="●  جاهز للترجمة"
            android:textColor="#35D07F"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="16dp"/>


        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الترجمة تعمل محلياً بعد تنزيل نماذج اللغة"
            android:textColor="#526581"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</ScrollView>
