<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F2F2F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:background="@drawable/icon_background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="文"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مترجم الشاشة"
                    android:textColor="#111111"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ترجمة الشاشة بشكل فوري"
                    android:textColor="#8E8E93"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- Main Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginTop="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ترجمة الشاشة"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ترجم النصوص الإنجليزية الظاهرة على الشاشة إلى العربية."
                android:textColor="#8E8E93"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="6dp"/>


            <!-- Language -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#F2F2F7"
                android:layout_marginTop="20dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="🇬🇧  English"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="→"
                    android:textColor="#007AFF"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="العربية  🇸🇦"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>


        <!-- Start -->

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="ابدأ الترجمة"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#007AFF"
            android:layout_marginTop="16dp"/>


        <!-- Status -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:text="●"
                android:textColor="#34C759"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="جاهز للترجمة"
                android:textColor="#3C3C43"
                android:textSize="14sp"
                android:layout_marginStart="10dp"/>

        </LinearLayout>


        <!-- Privacy -->

        <Button
            android:id="@+id/privacyButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="سياسة الخصوصية"
            android:textColor="#007AFF"
            android:textSize="14sp"
            android:backgroundTint="#FFFFFF"
            android:layout_marginTop="12dp"/>


        <!-- Footer -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تعمل الترجمة محلياً بعد تنزيل نماذج اللغة"
            android:textColor="#AEAEB2"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

</ScrollView>
