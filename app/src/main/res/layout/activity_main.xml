<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:gravity="center"
                android:background="#2563EB">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="文"
                    android:textColor="#FFFFFF"
                    android:textSize="27sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مترجم الشاشة"
                    android:textColor="#111827"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ترجمة فورية من الشاشة"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- Main Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="22dp"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جاهز للترجمة"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="حدد أي منطقة تحتوي على نص إنجليزي، وسنقوم بترجمته إلى العربية."
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="7dp"/>


            <!-- Language Row -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="22dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="🇬🇧  English"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="#F3F6FA"/>

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="→"
                    android:textColor="#2563EB"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="العربية  🇸🇦"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="#F3F6FA"/>

            </LinearLayout>

        </LinearLayout>


        <!-- Start Button -->

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="ابدأ الترجمة"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"
            android:layout_marginTop="18dp"/>


        <!-- Status -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:text="●"
                android:textColor="#16A34A"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="جاهز للترجمة"
                android:textColor="#374151"
                android:textSize="14sp"
                android:layout_marginStart="10dp"/>

        </LinearLayout>


        <!-- Tools -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/errorButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="سجل الأخطاء"
                android:textSize="13sp"/>

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/clearErrorButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="مسح الأخطاء"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- Privacy -->

        <Button
            android:id="@+id/privacyButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="سياسة الخصوصية"
            android:textSize="14sp"
            android:layout_marginTop="10dp"/>


        <!-- Error -->

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B91C1C"
            android:textSize="12sp"
            android:background="#FFF1F2"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:textIsSelectable="true"
            android:visibility="visible"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الترجمة تتم محلياً بعد تنزيل نماذج اللغة"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>
